{
  "name": "sleepcore-mini-app",
  "version": "1.0.0",
  "description": "SleepCore Telegram Mini App - Haptic Breathing & Wellness",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 30",
    "lint:strict": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "sbom": "npx @cyclonedx/cyclonedx-npm --output-format json --output-file sbom.json",
    "licenses": "npx license-checker --summary --production"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@formkit/auto-animate": "^0.9.0",
    "@sentry/react": "^10.39.0",
    "@sentry/vite-plugin": "^4.9.1",
    "@t3-oss/env-core": "^0.13.10",
    "@tanstack/react-query": "^5.90.12",
    "@twa-dev/sdk": "^8.0.2",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.1.0",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^6.30.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.49",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^3.4.16",
    "terser": "^5.44.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.55.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
