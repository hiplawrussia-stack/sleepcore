# SleepCore Mini App Environment Variables

# Backend API URL (optional - defaults to /api)
VITE_API_URL=http://localhost:3000/api

# Sentry Error Monitoring (production only)
VITE_SENTRY_DSN=
VITE_APP_VERSION=1.0.0

# Sentry Sourcemap Upload (CI/CD only, not exposed to client)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=sleepcore
# SENTRY_PROJECT=mini-app
