<?xml version="1.0" encoding="utf-8"?>
<!--
  SleepCore Companion App - Android Manifest
  ==========================================
  Health Connect permissions based on research (February 2026):
  - Sleep sessions (READ/WRITE)
  - Heart Rate Variability (READ) - RMSSD for sleep quality
  - Heart Rate (READ) - Resting HR correlation
  - Resting Heart Rate (READ)
  - Background read (Android 15+) for periodic sync
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet for API communication -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service for sync operations -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <!-- Wake lock for WorkManager -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Health Connect Permissions
      Based on World Sleep Society 2025 Fundamental Sleep Measures:
      - TST, SOL, SE, WASO, Sleep Stages, TIB, Awakenings
      Plus HRV (RMSSD) for sleep quality assessment
    -->

    <!-- Sleep Data - Core requirement -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!-- HRV Data - Research: r=0.937-0.979 correlation with ECG for RMSSD -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />

    <!-- Heart Rate - For resting HR and sleep HR patterns -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />

    <!-- Background Read (Android 15+) - For periodic sync every 15 minutes -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- Historical Data (>30 days) - For complete sleep history -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <!--
      Enhanced Sleep Metrics (Added Feb 2026)
      Based on sleep apnea screening research:
      - SpO2: Oxygen saturation drops indicate apnea events
      - Respiratory Rate: Breathing pattern analysis
      - Skin Temperature: Circadian rhythm marker
      Source: AASM Technical Guidelines 2024
    -->
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
    <uses-permission android:name="android.permission.health.READ_SKIN_TEMPERATURE" />

    <application
        android:name=".SleepCoreCompanionApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SleepCoreCompanion"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SleepCoreCompanion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              HTTPS App Links for device linking from Telegram
              ==================================================
              Security: HTTPS App Links are verified via assetlinks.json
              and cannot be hijacked by other apps (unlike custom schemes).

              IMPORTANT: Deploy assetlinks.json to:
              https://sleepcore.ru/.well-known/assetlinks.json

              Source: OWASP MASVS-PLATFORM-1 (2025)
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Primary: HTTPS App Link (verified, secure) -->
                <data
                    android:scheme="https"
                    android:host="app.sleepcore.app"
                    android:pathPrefix="/link" />
            </intent-filter>

            <!-- Fallback: Custom scheme for backwards compatibility -->
            <!-- TODO: Remove after migration complete (target: 2026-Q3) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="sleepcore"
                    android:host="link" />
            </intent-filter>
        </activity>

        <!--
          Privacy Policy Activity for Health Connect
          ===========================================
          Required by Google Play and Health Connect guidelines.
          Must display the same privacy policy as in Play Console.

          Research (Feb 2026):
          - Android 13-: ACTION_SHOW_PERMISSIONS_RATIONALE
          - Android 14+: VIEW_PERMISSION_USAGE + HEALTH_PERMISSIONS + activity-alias
          Source: developer.android.com/health-and-fitness/health-connect/get-started
        -->
        <activity
            android:name=".presentation.privacy.PrivacyPolicyActivity"
            android:exported="true"
            android:label="@string/privacy_policy_title">
            <!-- Android 13 and lower (APK-based Health Connect) -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+ (Platform Health Connect) - activity-alias pattern -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".presentation.privacy.PrivacyPolicyActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- WorkManager for background sync -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Health Connect availability meta-data -->
        <meta-data
            android:name="health_connect_opt_in_enabled"
            android:value="true" />

        <!--
          Sentry Configuration (HIPAA BAA Required)
          ==========================================
          IMPORTANT: Replace with your Sentry DSN from sentry.io
          Requires Business tier for HIPAA BAA compliance.

          Research (Feb 2026): Sentry 8.x best practices
          - Manual initialization for beforeSend PHI scrubbing
          - Source: docs.sentry.io/platforms/android/
        -->
        <meta-data
            android:name="io.sentry.dsn"
            android:value="${SENTRY_DSN}" />
        <meta-data
            android:name="io.sentry.send-default-pii"
            android:value="false" />
        <meta-data
            android:name="io.sentry.traces.sample-rate"
            android:value="0.1" />
        <meta-data
            android:name="io.sentry.session-tracking.enable"
            android:value="true" />
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />


    </application>

    <!-- Health Connect availability query -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_HEALTH_CONNECT_SETTINGS" />
        </intent>
    </queries>

</manifest>
