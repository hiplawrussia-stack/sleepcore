    <!-- Privacy Policy (GDPR Article 13/14 Compliant) -->
    <string name="privacy_policy_title">Privacy Policy</string>

    <string name="privacy_policy_intro">This Privacy Policy explains how SleepCore Companion App collects, uses, and protects your health data from Health Connect. This policy applies to all users of the SleepCore digital therapeutic platform for insomnia treatment.</string>

    <!-- Data Controller (GDPR Article 13.1.a) -->
    <string name="privacy_section_controller">Data Controller</string>
    <string name="privacy_controller_content">The data controller is Charitable Foundation \"Another Way\" (BF \"Drugoy Put\"), registered in the Russian Federation.\n\nContact: privacy@sleepcore.ru</string>

    <!-- Data Collected -->
    <string name="privacy_section_data_collected">Health Data We Collect</string>
    <string name="privacy_data_sleep">Sleep Sessions: duration, start/end times, sleep stages (REM, deep, light, awake)</string>
    <string name="privacy_data_hrv">Heart Rate Variability (HRV): RMSSD measurements for sleep quality assessment</string>
    <string name="privacy_data_heart_rate">Heart Rate: average heart rate during sleep periods</string>
    <string name="privacy_data_resting_hr">Resting Heart Rate: daily baseline measurements</string>
    <string name="privacy_data_spo2">Blood Oxygen (SpO2): oxygen saturation levels during sleep</string>
    <string name="privacy_data_respiratory">Respiratory Rate: breathing patterns and potential disturbances</string>
    <string name="privacy_data_temperature">Skin Temperature: circadian rhythm indicators</string>

    <!-- Purpose (GDPR Article 13.1.c) -->
    <string name="privacy_section_purpose">Why We Collect Your Data</string>
    <string name="privacy_purpose_therapy">Provide personalized CBT-I (Cognitive Behavioral Therapy for Insomnia) recommendations</string>
    <string name="privacy_purpose_progress">Track your sleep improvement progress over the therapy course</string>
    <string name="privacy_purpose_metrics">Calculate sleep efficiency, total sleep time, and other clinical metrics</string>
    <string name="privacy_purpose_patterns">Identify patterns and factors affecting your sleep quality</string>
    <string name="privacy_purpose_screening">Screen for potential sleep breathing disorders using SpO2 and respiratory data</string>
    <string name="privacy_purpose_circadian">Monitor circadian rhythm indicators via temperature patterns</string>

    <!-- Legal Basis (GDPR Article 13.1.c) -->
    <string name="privacy_section_legal_basis">Legal Basis for Processing</string>
    <string name="privacy_legal_basis_content">We process your health data based on your explicit consent (GDPR Article 9.2.a). You provide this consent when you grant Health Connect permissions and link your device to SleepCore.\n\nYou may withdraw your consent at any time by unlinking your device or revoking Health Connect permissions.</string>

    <!-- Data Retention (GDPR Article 13.2.a) -->
    <string name="privacy_section_retention">Data Retention</string>
    <string name="privacy_retention_content">Your health data is retained for the duration of your therapy program plus 6 years for medical record compliance (FDA 21 CFR Part 11, HIPAA).\n\nWhen you unlink your device, your data is marked for deletion and permanently erased within 30 days, unless retention is required by law.</string>

    <!-- Security -->
    <string name="privacy_section_security">Data Protection</string>
    <string name="privacy_security_tls">All data is encrypted in transit using TLS 1.3</string>
    <string name="privacy_security_encryption">Data at rest is encrypted using AES-256-GCM</string>
    <string name="privacy_security_hipaa">Stored on HIPAA-compliant infrastructure</string>
    <string name="privacy_security_no_sharing">We never sell or share your data with third parties for marketing</string>

    <!-- Data Transfers (GDPR Article 13.1.f) -->
    <string name="privacy_section_transfers">International Data Transfers</string>
    <string name="privacy_transfers_content">Your data may be processed on servers located in the European Union and/or Russian Federation. We ensure appropriate safeguards are in place for any international transfers in accordance with applicable data protection laws.</string>

    <!-- Your Rights (GDPR Article 13.2.b-d) -->
    <string name="privacy_section_rights">Your Rights</string>
    <string name="privacy_right_access">Access: Request a copy of all data we hold about you</string>
    <string name="privacy_right_rectification">Rectification: Request correction of inaccurate data</string>
    <string name="privacy_right_erasure">Erasure: Request deletion of your data (\"right to be forgotten\")</string>
    <string name="privacy_right_portability">Portability: Receive your data in a machine-readable format</string>
    <string name="privacy_right_withdraw">Withdraw Consent: Revoke permissions at any time via device settings</string>
    <string name="privacy_right_complaint">Complaint: Lodge a complaint with your local data protection authority</string>

    <!-- Exercise Rights -->
    <string name="privacy_section_exercise_rights">How to Exercise Your Rights</string>
    <string name="privacy_exercise_rights_content">To exercise any of these rights:\n\n1. Unlink Device: Settings in this app to immediately stop data collection\n2. Revoke Permissions: Android Settings → Health Connect → SleepCore\n3. Data Request: Email privacy@sleepcore.ru with your request\n\nWe will respond to your request within 30 days.</string>

    <!-- Footer -->
    <string name="privacy_contact">Contact: privacy@sleepcore.ru</string>
    <string name="privacy_last_updated">Last updated: February 2026</string>
    <string name="privacy_version">Privacy Policy Version 2.0</string>

