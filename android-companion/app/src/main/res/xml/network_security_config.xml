<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration
  ================================
  Security Level: HIPAA/GDPR Compliant
  Last Updated: February 2026

  Certificate Pinning Strategy (OWASP MASVS-NETWORK-2):
  - Pin to Let's Encrypt ROOT certificates (not intermediates)
  - ISRG Root X1 valid until 2035 (stable)
  - ISRG Root X2 as backup (ECDSA, valid until 2040)
  - Intermediates R10-R14 rotate frequently - DO NOT PIN

  Sources:
  - https://letsencrypt.org/certificates/
  - OWASP MASVS 2.1 (2025)
-->
<network-security-config>
    <!-- Production domain with certificate pinning -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">sleepcore.app</domain>
        <!--
          SPKI SHA-256 pins for Let's Encrypt Root CAs:
          - ISRG Root X1 (RSA, expires 2035-06-04)
          - ISRG Root X2 (ECDSA, expires 2040-09-17) - backup

          Expiration set to 2027-06-01 for annual review cycle.
          Update pins if server migrates away from Let's Encrypt.
        -->
        <pin-set expiration="2027-06-01">
            <!-- ISRG Root X1 - Primary (RSA 4096, valid until 2035) -->
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin>
            <!-- ISRG Root X2 - Backup (ECDSA P-384, valid until 2040) -->
            <pin digest="SHA-256">diGVwiVYbubAI3RW4hB9xU8e/CH2bXMiWKuTB0IyBWQ=</pin>
        </pin-set>
    </domain-config>

    <!-- Debug configuration allows localhost and user certificates -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>

    <!-- Base config - no cleartext allowed (HIPAA/GDPR compliance) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
