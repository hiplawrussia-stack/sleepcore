<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration
  ================================
  Based on research (February 2026):
  - TLS 1.3 recommended for health apps (HIPAA 2025)
  - Certificate pinning with backup pins (OWASP MASVS-NETWORK-2)
  - Debug allows localhost for development
  - Expiration date required for pin rotation planning

  IMPORTANT: Before production deployment:
  1. Generate real SHA-256 SPKI pins using:
     openssl s_client -connect api.sleepcore.ru:443 | openssl x509 -pubkey -noout | \
     openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | base64
  2. Add backup pin from CA certificate
  3. Update expiration date to match certificate validity
-->
<network-security-config>
    <!-- Production domain with certificate pinning -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.sleepcore.ru</domain>
        <!--
          Pin-set with backup pins per OWASP MASVS 2024-2025:
          - Primary: Server certificate SPKI hash
          - Backup: Intermediate CA certificate SPKI hash
          - Expiration: Set to certificate expiry for rotation planning

          TODO (PRE-PRODUCTION): Replace placeholder pins with real values:
          1. Primary pin: SHA-256 of server certificate public key
          2. Backup pin: SHA-256 of Let's Encrypt R3 or other CA certificate
        -->
        <pin-set expiration="2027-06-01">
            <!-- Primary: Server certificate (REPLACE BEFORE PRODUCTION) -->
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>
            <!-- Backup: CA certificate (Let's Encrypt R3 example - VERIFY AND UPDATE) -->
            <pin digest="SHA-256">jQJTbIh0grw0/1TkHSumWb+Fs0Ggogr621gT3PvPKG0=</pin>
        </pin-set>
    </domain-config>

    <!-- Debug configuration allows localhost and user certificates -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>

    <!-- Base config - no cleartext allowed (HIPAA/GDPR compliance) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
