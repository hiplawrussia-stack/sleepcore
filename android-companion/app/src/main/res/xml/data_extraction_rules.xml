<?xml version="1.0" encoding="utf-8"?>
<!--
  Data Extraction Rules
  =======================
  Health data should NOT be backed up or transferred.
  Based on HIPAA/GDPR compliance requirements.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all sensitive data from cloud backup -->
        <exclude domain="sharedpref" path="sleepcore_secure_prefs.xml"/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="."/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude sensitive data from device transfer -->
        <exclude domain="sharedpref" path="sleepcore_secure_prefs.xml"/>
        <exclude domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>
