        android:pathData="M34,68 Q40,64 46,68 Q52,72 58,68"/>

    <!-- Sleep wave 3 (small) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M38,76 Q42,74 46,76 Q50,78 54,76"/>

