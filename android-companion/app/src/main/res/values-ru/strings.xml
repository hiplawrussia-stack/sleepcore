    <!-- Samsung Accuracy Disclaimer -->
    <string name="samsung_disclaimer_title">Уведомление для Samsung Galaxy Watch</string>
    <string name="samsung_disclaimer_message">Некоторые модели Samsung Galaxy Watch (особенно Galaxy Watch 7/Ultra с One UI 8) могут неточно определять фазы сна. Если вы заметили значительные расхождения между вашим реальным сном и записанными данными, используйте субъективный дневник сна как основной источник данных.</string>
    <string name="samsung_disclaimer_learn_more">Подробнее</string>

    <!-- Unlink Dialog -->
    <string name="unlink_title">Отвязать устройство?</string>
    <string name="unlink_message">Это отключит ваше устройство от SleepCore. Для синхронизации данных о сне потребуется повторная привязка.</string>
    <string name="unlink_confirm">Отвязать</string>
    <string name="cancel">Отмена</string>

    <!-- Privacy Policy -->
    <string name="privacy_policy_title">Политика конфиденциальности</string>
    <string name="privacy_policy_content">
        Политика конфиденциальности приложения SleepCore Companion\n\n
        Мы собираем данные о сне из Health Connect для предоставления персонализированных рекомендаций по терапии сна.\n\n
        Собираемые данные:\n
        • Сессии сна (продолжительность, фазы)\n
        • Вариабельность сердечного ритма (ВСР)\n
        • Частота пульса во время сна\n
        • Пульс в покое\n
        • Насыщение крови кислородом (SpO2)\n
        • Частота дыхания\n
        • Температура кожи\n\n
        Ваши данные:\n
        • Шифруются при передаче (TLS 1.3)\n
        • Хранятся безопасно на наших серверах\n
        • Никогда не передаются третьим лицам\n
        • Используются только для вашей терапии сна\n\n
        Вы можете удалить свои данные в любое время, отвязав устройство.
    </string>

