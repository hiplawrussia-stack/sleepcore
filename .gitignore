# Dependencies
node_modules/
packages/*/node_modules/

# Build output
dist/

# Compiled TypeScript in source directories
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# Coverage reports
coverage/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# Runtime data (root level only)
/data/

# Claude Code
.claude/
tmpclaude-*

# Archives
*.zip

# Allow content library data
!src/modules/content/infrastructure/data/
