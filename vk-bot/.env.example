# VK Bot Environment Variables
# ============================
# Copy to .env and fill in values

# VK Community Bot Token (from VK Community → Управление → Работа с API)
VK_BOT_TOKEN=

# VK Community ID (число из URL сообщества)
VK_GROUP_ID=

# Admin VK User IDs for crisis escalation (comma-separated)
ADMIN_VK_USER_IDS=

# Redis URL for persistent sessions (optional, falls back to memory)
REDIS_URL=redis://localhost:6379

# Health check port
HEALTH_PORT=3002
