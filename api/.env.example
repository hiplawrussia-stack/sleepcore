# SleepCore API Configuration
# ===========================

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Telegram Bot Token (required)
BOT_TOKEN=your_bot_token_here

# JWT Secret (optional, defaults to BOT_TOKEN)
JWT_SECRET=your_jwt_secret_here

# Database path
DATABASE_PATH=./database/api.db

# CORS origin (Mini App URL)
CORS_ORIGIN=*

# PHI Encryption (required in production)
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=

# ===========================
# Oura Ring Integration
# ===========================
# Register at https://cloud.ouraring.com/oauth/applications
# Rate limit: 5,000 requests per 5 minutes

OURA_CLIENT_ID=your_oura_client_id
OURA_CLIENT_SECRET=your_oura_client_secret
OURA_REDIRECT_URI=https://your-domain.com/api/oura/callback
